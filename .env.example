# Region data source: api-wilayah-indonesia
# Deploy your own instance from https://github.com/cakfan/api-wilayah-indonesia
# Region resolver will use this base URL for all region queries.
REGION_API_BASE_URL=https://wilayah.id/api

# --- Provider API keys (bring-your-own-key) ---
# Biteship (sandbox: key biteship_test.* dari dashboard Testing Mode)
BITESHIP_API_KEY=

# Komerce (RajaOngkir by Komerce)
RAJAONGKIR_API_KEY=

# Shipper (sandbox key dari dashboard Shipper)
SHIPPER_API_KEY=

# Opsional: override base URL Shipper
# Production: https://merchant-api.shipper.id
# Sandbox:   https://merchant-api-sandbox.shipper.id
SHIPPER_BASE_URL=https://merchant-api.shipper.id

# --- Contoh (examples/) ---
# Provider default untuk /rates & /track di example hono-api (biteship | komerce | shipper)
DEFAULT_PROVIDER=

# Port server example hono-api
PORT=3000
