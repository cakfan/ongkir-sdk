{
  "name": "@ongkir-sdk/cache-memory",
  "version": "0.1.0",
  "description": "In-memory caching wrapper for any ongkir-sdk ShippingProvider",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cakfan/ongkir-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@ongkir-sdk/core": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
