{
  "name": "@ongkir-sdk/cache-memory",
  "version": "0.2.1",
  "description": "In-memory cache wrapper untuk provider ongkir-sdk — cache hasil getRates agar tidak membebani API cek ongkir.",
  "keywords": [
    "ongkir",
    "cache",
    "caching",
    "shipping-rates",
    "typescript",
    "sdk",
    "indonesia",
    "provider-wrapper"
  ],
  "homepage": "https://github.com/cakfan/ongkir-sdk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cakfan/ongkir-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src/"
  },
  "dependencies": {
    "@ongkir-sdk/core": "^2.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
